{
  "name": "openbeats",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "node tools/install-hooks.mjs",
    "check:staged": "node tools/check-staged.mjs",
    "lint": "eslint src tools eslint.config.mjs",
    "format:check": "prettier --check package.json eslint.config.mjs tools/*.mjs",
    "check:fast": "npm run lint && npm run format:check && npm run build",
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "lucide": "^0.468.0",
    "tone": "^14.7.77",
    "vite": "^6.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "eslint": "^9.39.1",
    "globals": "^16.5.0",
    "playwright": "^1.60.0",
    "prettier": "^3.8.2"
  }
}
